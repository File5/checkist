# Server environment for the systemd units in deploy/systemd/.
# Copy to /etc/checkist/checkist.env, owner root:checkist, mode 0640 or stricter; never commit the copy.
# systemd EnvironmentFile format: NAME=value, no quotes, no `export`, no variable expansion.
# There is no .env in /opt/checkist on a server: this file is the only source.
# Replace checkist.example with the real domain (also in the Caddyfile).

# Sign-in is required; `local_single` is refused together with DJANGO_DEBUG=0.
CHECKIST_AUTH_MODE=accounts
DJANGO_DEBUG=0
# Secrets are left empty on purpose: the services refuse to start until they are filled.
# Key: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=checkist.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://checkist.example

# Caddy overwrites X-Forwarded-Proto / X-Forwarded-For; gunicorn listens on loopback only.
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_COOKIES=1
# Keep equal to max-age in the Caddyfile; raise both only after the server is accepted.
DJANGO_HSTS_SECONDS=3600
# `manage.py collectstatic` target; Caddy serves it as /static/.
DJANGO_STATIC_ROOT=/var/lib/checkist/static

# PostgreSQL and Redis are OS packages listening on loopback only.
POSTGRES_DB=checkist
POSTGRES_USER=checkist
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
DJANGO_CACHE_URL=redis://127.0.0.1:6379/2

# The local-only API switch is for DEBUG dev/QA; on a server access comes from the account.
ALLOW_LOCAL_RECOGNITION_API=0
PRODUCT_MERGE_AUTO_DETECT=0
PRODUCT_CLASSIFICATION_AUTO_SUGGEST=0

# Uploaded photos; served only by Django. The web service and the worker share this directory.
MEDIA_ROOT=/var/lib/checkist/media
# Private provider scratch, outside MEDIA; not part of backups.
RECEIPT_OCR_TEMP_ROOT=/var/lib/checkist/ocr-scratch
RECEIPT_OCR_PROVIDER=codex_cli
# Absolute path: systemd does not use the login PATH of the `checkist` user.
RECEIPT_OCR_CODEX_EXECUTABLE=/usr/local/bin/codex
