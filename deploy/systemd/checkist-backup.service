# One backup: database dump and MEDIA archive; started by checkist-backup.timer.
# A copy holds the receipts and photos of every user: protect /var/backups/checkist like the server itself.
[Unit]
Description=Checkist backup (database and MEDIA)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=checkist
Group=checkist
WorkingDirectory=/opt/checkist/backend
EnvironmentFile=/etc/checkist/checkist.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/checkist/backend/.venv/bin/python manage.py backup create --dir /var/backups/checkist --keep-days 14
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
InaccessiblePaths=-/home/checkist/.codex
ReadWritePaths=/var/backups/checkist
