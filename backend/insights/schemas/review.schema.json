{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "changes", "limits", "advice"],
  "properties": {
    "summary": {"type": "string", "maxLength": 600},
    "changes": {"type": ["string", "null"], "maxLength": 600},
    "limits": {"type": ["string", "null"], "maxLength": 400},
    "advice": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 300}
    }
  }
}
