{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["total", "currency", "category", "purchased_on", "store_name", "note", "lines"],
  "properties": {
    "total": {"type": ["string", "null"], "maxLength": 15, "pattern": "^[0-9]{1,12}(\\.[0-9]{1,2})?$"},
    "currency": {"type": ["string", "null"], "maxLength": 3, "pattern": "^[A-Z]{3}$"},
    "category": {"type": ["integer", "null"], "minimum": 1},
    "purchased_on": {"type": ["string", "null"], "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "store_name": {"type": ["string", "null"], "maxLength": 100},
    "note": {"type": ["string", "null"], "maxLength": 200},
    "lines": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "amount", "quantity", "category"],
        "properties": {
          "name": {"type": "string", "maxLength": 200},
          "amount": {"type": "string", "maxLength": 15, "pattern": "^[0-9]{1,12}(\\.[0-9]{1,2})?$"},
          "quantity": {"type": ["string", "null"], "maxLength": 13, "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$"},
          "category": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
