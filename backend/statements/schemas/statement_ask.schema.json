{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "store_name"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 40},
          "category": {"type": ["integer", "null"], "minimum": 1},
          "store_name": {"type": ["string", "null"], "maxLength": 100}
        }
      }
    }
  }
}
