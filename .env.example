COMPOSE_PROJECT_NAME=checkist_dev
POSTGRES_DB=checkist_dev
POSTGRES_USER=checkist
POSTGRES_PASSWORD=checkist_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
DJANGO_CACHE_URL=redis://127.0.0.1:6379/2
DJANGO_SECRET_KEY=dev-only-checkist-key-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Recognition is for local dev/QA only. Explicitly enable it when the API is installed.
ALLOW_LOCAL_RECOGNITION_API=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:15173,http://localhost:15173
# Search for duplicate products right after a receipt import (0/1). Keep 0 until the owner
# decides to apply merges to this database; `manage.py product_merges detect` runs it manually.
PRODUCT_MERGE_AUTO_DETECT=0
# Suggest a generic product and a category for new products right after a receipt import (0/1).
# Keep 0 until the owner decides to apply suggestions to this database;
# `manage.py product_classifications suggest` and the «Предложить категории» button run it manually.
PRODUCT_CLASSIFICATION_AUTO_SUGGEST=0
PRODUCT_CLASSIFICATION_TIMEOUT_SECONDS=180
PRODUCT_CLASSIFICATION_BATCH_SIZE=25
PRODUCT_CLASSIFICATION_RUN_LIMIT=200
# MEDIA_ROOT defaults to <worktree>/media; set an absolute, separate QA directory.
# MEDIA_ROOT=C:/absolute/path/to/checkist-media
# Fixed in v1: only /media/ is accepted; other values fail at settings load.
# Changing it requires coordinated client URL guard and Vite proxy changes.
MEDIA_URL=/media/
RECEIPT_OCR_PROVIDER=codex_cli
RECEIPT_OCR_MODEL=gpt-6.1-sol
# May be an executable path with spaces; never a shell command with arguments.
RECEIPT_OCR_CODEX_EXECUTABLE=codex
# Defaults to a private worktree-specific directory in system temp, outside MEDIA.
# RECEIPT_OCR_TEMP_ROOT=C:/absolute/path/to/private-scratch
RECEIPT_OCR_PREPARE_TIMEOUT_SECONDS=30
RECEIPT_OCR_CROP_TIMEOUT_SECONDS=30
RECEIPT_OCR_DETECT_TIMEOUT_SECONDS=90
RECEIPT_OCR_RECOGNIZE_TIMEOUT_SECONDS=180
RECEIPT_OCR_JOB_TIMEOUT_SECONDS=2400
RECEIPT_OCR_CANCEL_GRACE_SECONDS=2
RECEIPT_OCR_LEASE_SECONDS=30
RECEIPT_OCR_HEARTBEAT_SECONDS=5
RECEIPT_OCR_MAX_CONCURRENCY=1
RECEIPT_OCR_MAX_ATTEMPTS=2
RECEIPT_IMAGE_MAX_BYTES=20971520
RECEIPT_IMAGE_MAX_PIXELS=40000000
RECEIPT_IMAGE_MAX_RECEIPTS=10

# Server deployment behind an HTTPS reverse proxy (DJANGO_DEBUG=0). Keep commented for local dev/QA:
# the defaults follow DJANGO_DEBUG. On a server also replace DJANGO_SECRET_KEY, set
# DJANGO_ALLOWED_HOSTS=<domain> and DJANGO_CSRF_TRUSTED_ORIGINS=https://<domain>
# (a non-local origin is accepted only as https://<host from DJANGO_ALLOWED_HOSTS>, no port, no path).
# Trust X-Forwarded-Proto / X-Forwarded-For and redirect http to https (0/1). Enable only behind
# a proxy that overwrites these headers; default 0.
# DJANGO_TRUST_PROXY=1
# Secure flag of the session and CSRF cookies (0/1); default 0 with DJANGO_DEBUG=1, otherwise 1.
# DJANGO_SECURE_COOKIES=1
# Strict-Transport-Security max-age, 0..63072000; default 0 with DJANGO_DEBUG=1, otherwise 3600.
# Raise only after the server is accepted: a browser remembers it for the whole period.
# DJANGO_HSTS_SECONDS=3600
# Absolute directory for `manage.py collectstatic`; default <worktree>/staticfiles.
# DJANGO_STATIC_ROOT=/absolute/path/to/checkist-static
