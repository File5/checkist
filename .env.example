COMPOSE_PROJECT_NAME=checkist_dev
POSTGRES_DB=checkist_dev
POSTGRES_USER=checkist
POSTGRES_PASSWORD=checkist_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
DJANGO_CACHE_URL=redis://127.0.0.1:6379/2
DJANGO_SECRET_KEY=dev-only-checkist-key-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Recognition is for local dev/QA only. Explicitly enable it when the API is installed.
ALLOW_LOCAL_RECOGNITION_API=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:15173,http://localhost:15173
# MEDIA_ROOT defaults to <worktree>/media; set an absolute, separate QA directory.
# MEDIA_ROOT=C:/absolute/path/to/checkist-media
MEDIA_URL=/media/
RECEIPT_OCR_PROVIDER=codex_cli
RECEIPT_OCR_MODEL=gpt-6.1-sol
# May be an executable path with spaces; never a shell command with arguments.
RECEIPT_OCR_CODEX_EXECUTABLE=codex
# Defaults to a private worktree-specific directory in system temp, outside MEDIA.
# RECEIPT_OCR_TEMP_ROOT=C:/absolute/path/to/private-scratch
RECEIPT_OCR_PREPARE_TIMEOUT_SECONDS=30
RECEIPT_OCR_CROP_TIMEOUT_SECONDS=30
RECEIPT_OCR_DETECT_TIMEOUT_SECONDS=90
RECEIPT_OCR_RECOGNIZE_TIMEOUT_SECONDS=180
RECEIPT_OCR_JOB_TIMEOUT_SECONDS=2400
RECEIPT_OCR_CANCEL_GRACE_SECONDS=2
RECEIPT_OCR_LEASE_SECONDS=30
RECEIPT_OCR_HEARTBEAT_SECONDS=5
RECEIPT_OCR_MAX_CONCURRENCY=1
RECEIPT_OCR_MAX_ATTEMPTS=2
RECEIPT_IMAGE_MAX_BYTES=20971520
RECEIPT_IMAGE_MAX_PIXELS=40000000
RECEIPT_IMAGE_MAX_RECEIPTS=10
